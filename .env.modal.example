# Modal Environment Configuration for Parallax
# Copy this file to .env.modal and update with your values

# ============================================
# REQUIRED SETTINGS
# ============================================

# JWT Secret for authentication (generate a secure random string)
JWT_SECRET=your-secure-jwt-secret-key-here-change-this

# Modal organization (your Modal username or org name)
MODAL_ORG=your-modal-username

# ============================================
# MODAL DEPLOYMENT
# ============================================

# GPU Configuration
GPU_TYPE=A10G  # Options: T4, A10G, A100, H100
GPU_COUNT=1    # Number of GPUs per worker

# Worker Configuration
WORKER_COUNT=2              # Number of worker instances
WORKER_CONCURRENCY=5        # Max concurrent requests per worker
WORKER_IDLE_TIMEOUT=600     # Seconds before idle shutdown
WORKER_MEMORY_MB=32768      # Memory per worker in MB
WORKER_CPU_CORES=8          # CPU cores per worker

# Scheduler Configuration
SCHEDULER_CONCURRENCY=10    # Max concurrent scheduler requests
SCHEDULER_IDLE_TIMEOUT=300  # Seconds before idle shutdown

# ============================================
# MODEL SETTINGS
# ============================================

# Default model to load
MODEL_NAME=meta-llama/Llama-2-7b-chat-hf

# HuggingFace token (for gated models)
HF_TOKEN=hf_your_huggingface_token_here

# Model inference settings
MAX_BATCH_SIZE=32
MAX_SEQ_LENGTH=2048
MAX_NEW_TOKENS=512
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.9

# Model cache directory (in Modal Volume)
MODEL_CACHE_DIR=/models

# ============================================
# NETWORKING
# ============================================

# Parallax ports (internal)
PARALLAX_PORT=3001
WORKER_PORT=3000
CHAT_UI_PORT=3002

# Public URLs (Modal will provide these)
# These will be auto-generated as:
# https://{MODAL_ORG}-parallax-scheduler.modal.run
# https://{MODAL_ORG}-parallax-chat.modal.run

# ============================================
# P2P NETWORKING (Optional)
# ============================================

# Enable P2P networking
P2P_ENABLED=false

# Relay server for P2P communication
RELAY_SERVER_URL=wss://relay.example.com

# P2P network ID
P2P_NETWORK_ID=parallax-network

# ============================================
# AUTHENTICATION & SECURITY
# ============================================

# Enable authentication
ENABLE_AUTH=false

# Admin credentials (if auth enabled)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# API key for external access
API_KEY=your-api-key-here

# CORS settings
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# ============================================
# MONITORING & LOGGING
# ============================================

# Logging level
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# Enable detailed performance logging
ENABLE_METRICS=true

# Telemetry endpoint (optional)
TELEMETRY_ENDPOINT=

# ============================================
# STORAGE
# ============================================

# Modal Volume names
MODEL_VOLUME_NAME=parallax-models
SHARED_STATE_VOLUME_NAME=parallax-shared-state

# Volume size limits (GB)
MODEL_VOLUME_SIZE=100
SHARED_STATE_VOLUME_SIZE=10

# ============================================
# DEVELOPMENT
# ============================================

# Development mode
DEV_MODE=false

# Hot reload
HOT_RELOAD=false

# Debug endpoints
ENABLE_DEBUG_ENDPOINTS=false

# ============================================
# ADVANCED SETTINGS
# ============================================

# Request timeout (seconds)
REQUEST_TIMEOUT=120

# Streaming buffer size
STREAM_BUFFER_SIZE=1024

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=30

# Max request size (MB)
MAX_REQUEST_SIZE=10

# Rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds

# ============================================
# INFERENCE ENGINE
# ============================================

# Inference engine backend
INFERENCE_ENGINE=sglang  # Options: sglang, vllm, transformers, mlx

# SGLang specific settings
SGLANG_TP_SIZE=1  # Tensor parallelism size
SGLANG_DISABLE_RADIX=false
SGLANG_ENABLE_FLASHINFER=true

# VLLM specific settings (if using vLLM)
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_PIPELINE_PARALLEL_SIZE=1

# ============================================
# CUSTOM ENDPOINTS
# ============================================

# Enable custom API endpoints
ENABLE_CUSTOM_ENDPOINTS=false

# Custom endpoint prefix
CUSTOM_ENDPOINT_PREFIX=/custom

# ============================================
# NOTES
# ============================================
# 1. Copy this file to .env.modal before deployment
# 2. Update all values marked with 'change-this' or 'your-'
# 3. Generate secure secrets using: openssl rand -base64 32
# 4. Add secrets to Modal dashboard for production
# 5. Never commit .env.modal to version control